---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Katalog — CAVA PERFUME Collection";
const description = "Discover the complete CAVA PERFUME collection of eau de parfum, from CAVA NO.01 to NO.06.";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "CAVA PERFUME",
  "description": "Discover the complete CAVA PERFUME collection of eau de parfum, from CAVA NO.01 to NO.06.",
  "isPartOf": {
    "@type": "WebSite",
    "name": "CAVA PERFUME",
    "url": "https://id-preview--0b81df86-aa7b-4188-920d-4464189dc207.lovable.app"
  }
};
---

<BaseLayout
  title={title}
  description={description}
  ogImage="/media/cava-duo.jpg"
  ogType="website"
  preload="/media/cava-duo.jpg"
  jsonLd={jsonLd}
>
<div class="cursor" aria-hidden="true">VIEW</div>

<header class="nav" id="nav">
  <a class="logo" href="/" aria-label="CAVA Perfume beranda">CAVA<small>Parfums | Luxury Fragrances</small></a>
  <nav aria-label="Navigasi utama">
    <ul class="nav-links">
      <li><a href="/">Beranda</a></li>
      <li class="nav-shop"><a href="/online-shop">Online Shop</a></li>
      <li><a href="/varian-aroma">Varian Aroma</a></li>
      <li><a href="/katalog" aria-current="page">Katalog</a></li>
      <li><a href="/kontak">Kontak</a></li>
    </ul>
  </nav>
  <button class="burger" id="burger" aria-label="Buka menu" aria-expanded="false"><span></span><span></span><span></span></button>
</header>
<div class="mobile-menu" id="mobileMenu" role="dialog" aria-label="Menu">
  <ol>
    <li><a href="/">Beranda</a></li>
    <li><a href="/online-shop">Online Shop</a></li>
    <li><a href="/varian-aroma">Varian Aroma</a></li>
    <li><a href="/katalog">Katalog</a></li>
    <li><a href="/kontak">Kontak</a></li>
  </ol>
  <div class="menu-foot">hello@cavaperfume.com</div>
</div>

<main id="main" tabindex="-1"><section class="page-hero">
  <img decoding="async" loading="eager" class="bg" src="/media/cava-duo.jpg" alt="" data-par="-40" fetchpriority="high">
  <div class="inner">
    <p class="eyebrow">Katalog</p>
    <h1 class="disp mask in" style="margin-top:1.5rem"><span>The Collection</span></h1>
    <p class="lede" style="margin-top:2rem;color:rgba(255,255,255,.75)">Discover the complete CAVA PERFUME collection.</p>
  </div>
</section>

<section class="section wrap" id="scent-finder" style="padding-bottom:0">
  <p class="eyebrow">Scent finder</p>
  <h2 class="disp-sm reveal" style="margin:1.25rem 0 2.5rem">Find your CAVA</h2>
  <div class="quiz reveal" id="quiz">
    <div class="quiz-head">
      <p class="eyebrow" id="qStep">Question 01 / 04</p>
      <p class="eyebrow">Approx. 30 seconds</p>
    </div>
    <div class="quiz-bar"><i id="qBar"></i></div>

    <div class="step active" data-step="0">
      <h3 class="q">When do you wear it?</h3>
      <div class="opts">
        <button class="opt" type="button" data-w="fresh:2,musk:1" aria-label="Daylight — Morning dan office"><span>Daylight</span>Morning &amp; office</button>
        <button class="opt" type="button" data-w="floral:2,musk:1" aria-label="Afternoon — Lunch dan city walks"><span>Afternoon</span>Lunch &amp; city walks</button>
        <button class="opt" type="button" data-w="oriental:2,woody:1" aria-label="Evening — Dinner dan events"><span>Evening</span>Dinner &amp; events</button>
        <button class="opt" type="button" data-w="woody:2,oriental:1" aria-label="After dark — Late, quiet hours"><span>After dark</span>Late, quiet hours</button>
      </div>
    </div>

    <div class="step" data-step="1">
      <h3 class="q">Choose a texture.</h3>
      <div class="opts">
        <button class="opt" type="button" data-w="fresh:2" aria-label="Sea salt — Cool, airy, clean"><span>Sea salt</span>Cool, airy, clean</button>
        <button class="opt" type="button" data-w="floral:2" aria-label="Silk petals — Soft and luminous"><span>Silk petals</span>Soft and luminous</button>
        <button class="opt" type="button" data-w="woody:2" aria-label="Dry cedar — Smoke and stone"><span>Dry cedar</span>Smoke and stone</button>
        <button class="opt" type="button" data-w="oriental:2" aria-label="Warm resin — Amber and spice"><span>Warm resin</span>Amber and spice</button>
      </div>
    </div>

    <div class="step" data-step="2">
      <h3 class="q">How loud is your sillage?</h3>
      <div class="opts">
        <button class="opt" type="button" data-w="musk:2,fresh:1" aria-label="Whisper — Skin-close, intimate"><span>Whisper</span>Skin-close, intimate</button>
        <button class="opt" type="button" data-w="floral:1,fresh:1" aria-label="Quiet — Noticed up close"><span>Quiet</span>Noticed up close</button>
        <button class="opt" type="button" data-w="woody:1,oriental:1" aria-label="Present — Fills a room slowly"><span>Present</span>Fills a room slowly</button>
        <button class="opt" type="button" data-w="oriental:2" aria-label="Statement — Unmistakable trail"><span>Statement</span>Unmistakable trail</button>
      </div>
    </div>

    <div class="step" data-step="3">
      <h3 class="q">Pick a mood.</h3>
      <div class="opts">
        <button class="opt" type="button" data-w="fresh:2" aria-label="Effortless — Light and unbothered"><span>Effortless</span>Light and unbothered</button>
        <button class="opt" type="button" data-w="floral:2,musk:1" aria-label="Elegant — Refined and calm"><span>Elegant</span>Refined and calm</button>
        <button class="opt" type="button" data-w="woody:2" aria-label="Grounded — Steady and composed"><span>Grounded</span>Steady and composed</button>
        <button class="opt" type="button" data-w="oriental:2,musk:1" aria-label="Magnetic — Warm and close"><span>Magnetic</span>Warm and close</button>
      </div>
    </div>

    <div class="step" data-step="4" id="qResult">
      <div class="result" style="margin-top:2.5rem">
        <div class="rimg"><img decoding="async" loading="lazy" id="rImg" src="/images/cava-bottle-01.jpg" alt=""></div>
        <div>
          <span class="badge" id="rFamily">Your match</span>
          <h3 class="disp-sm" id="rName" style="margin:.5rem 0 1.25rem">CAVA NO.01</h3>
          <p class="lede" id="rDesc"></p>
          <hr class="rule" style="margin:2rem 0">
          <p class="meta" id="rNotes" style="margin:0"></p>
          <div class="quiz-nav">
            <button class="btn btn-dark" id="rView" type="button">View details <span class="arw">&rarr;</span></button>
            <button class="btn btn-ghost" id="rAgain" type="button">Start over</button>
          </div>
        </div>
      </div>
    </div>

    <div class="quiz-nav" id="qNav">
      <button class="btn btn-ghost" id="qBack" type="button" hidden>&larr; Back</button>
      <p class="eyebrow" id="qHint">Select an option to continue</p>
    </div>
  </div>
</section>

<section class="section wrap" id="collection">
  <div class="cards">
    
<article class="card reveal" data-delay="0" data-cursor="VIEW" tabindex="0" role="button"
  data-name="CAVA NO.01" data-desc="Bergamot, iris, dan amber dalam komposisi yang tenang namun berkarakter." data-top="Bergamot|Pink Pepper" data-heart="Iris|Jasmine" data-base="Amber|Cedarwood|Musk" data-img="/images/cava-bottle-01.jpg">
  <div class="ph"><img decoding="async" src="/images/cava-bottle-01.jpg" alt="CAVA NO.01 eau de parfum" loading="lazy"></div>
