</footer>

<script is:inline>
/* respects prefers-reduced-motion: skips parallax + heavy effects */

const nav=document.getElementById('nav');
addEventListener('scroll',()=>{nav.classList.toggle('scrolled',scrollY>40)},{passive:true});
const burger=document.getElementById('burger');
burger.addEventListener('click',()=>{
  const open=document.body.classList.toggle('menu-open');
  burger.setAttribute('aria-expanded',open);
  burger.setAttribute('aria-label',open?'Tutup menu':'Buka menu');
});
document.querySelectorAll('#mobileMenu a').forEach(a=>a.addEventListener('click',()=>document.body.classList.remove('menu-open')));
addEventListener('keydown',e=>{if(e.key==='Escape')document.body.classList.remove('menu-open')});

const io=new IntersectionObserver((es)=>{es.forEach(e=>{if(e.isIntersecting){
  const el=e.target;const d=el.dataset.delay||0;setTimeout(()=>el.classList.add('in'),d);io.unobserve(el);}})},{threshold:.16});
document.querySelectorAll('.reveal,.mask,.img-reveal').forEach(el=>io.observe(el));

// parallax
const reduce=matchMedia('(prefers-reduced-motion:reduce)').matches;
const px=reduce?[]:[...document.querySelectorAll('[data-par]')];
let ticking=false;
function par(){px.forEach(el=>{const r=el.getBoundingClientRect();
  const p=(r.top+r.height/2-innerHeight/2)/innerHeight;
  el.style.transform='translate3d(0,'+(p*parseFloat(el.dataset.par)).toFixed(2)+'px,0)';});ticking=false;}
addEventListener('scroll',()=>{if(!ticking){ticking=true;requestAnimationFrame(par)}},{passive:true});par();

// smooth scroll (lightweight lerp)
if(matchMedia('(min-width:821px)').matches && !matchMedia('(prefers-reduced-motion:reduce)').matches){
  let target=scrollY,cur=scrollY,run=false;
  addEventListener('wheel',e=>{
    if(document.body.classList.contains('menu-open')||document.querySelector('.modal.open'))return;
    e.preventDefault();
    target=Math.max(0,Math.min(document.body.scrollHeight-innerHeight,target+e.deltaY));
    if(!run){run=true;requestAnimationFrame(loop)}
  },{passive:false});
  function loop(){cur+=(target-cur)*.09;if(Math.abs(target-cur)<.5){cur=target;run=false}
    scrollTo(0,cur);if(run)requestAnimationFrame(loop)}
  addEventListener('scrollend',()=>{if(!run){target=cur=scrollY}});
}

// custom cursor
const cur=document.querySelector('.cursor');
if(cur&&matchMedia('(hover:hover)').matches){
  addEventListener('mousemove',e=>{cur.style.left=e.clientX+'px';cur.style.top=e.clientY+'px'});
  document.querySelectorAll('[data-cursor]').forEach(el=>{
    el.addEventListener('mouseenter',()=>{cur.textContent=el.dataset.cursor;cur.classList.add('show')});
    el.addEventListener('mouseleave',()=>cur.classList.remove('show'));
  });
}

const modal=document.getElementById('modal');
function openModal(el){
  document.getElementById('mName').textContent=el.dataset.name;
  document.getElementById('mDesc').textContent=el.dataset.desc;
  document.getElementById('mTop').innerHTML=el.dataset.top.split('|').join('<br>');
  document.getElementById('mHeart').innerHTML=el.dataset.heart.split('|').join('<br>');
  document.getElementById('mBase').innerHTML=el.dataset.base.split('|').join('<br>');
  const im=document.getElementById('mImg');im.src=el.dataset.img;im.alt=el.dataset.name;
  modal.classList.add('open');
}
function closeModal(){modal.classList.remove('open')}
document.querySelectorAll('.card').forEach(c=>{
  c.addEventListener('click',()=>openModal(c));
  c.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();openModal(c)}});
});
document.getElementById('modalClose').addEventListener('click',closeModal);
modal.addEventListener('click',e=>{if(e.target===modal)closeModal()});
addEventListener('keydown',e=>{if(e.key==='Escape')closeModal()});

// scent finder quiz
(function(){
  const quiz=document.getElementById('quiz');if(!quiz)return;
  const steps=[...quiz.querySelectorAll('.step')];
  const bar=document.getElementById('qBar'),lbl=document.getElementById('qStep'),hint=document.getElementById('qHint');
  const back=document.getElementById('qBack');
  const total=steps.length-1;
  const map={fresh:'CAVA NO.02',floral:'CAVA NO.04',woody:'CAVA NO.05',oriental:'CAVA NO.03',musk:'CAVA NO.06'};
  const famLabel={fresh:'Fresh / Aquatic',floral:'Floral',woody:'Woody',oriental:'Oriental',musk:'Musk'};
  let i=0,picks=[];
  function show(n){
    i=n;steps.forEach((s,k)=>s.classList.toggle('active',k===n));
    const done=n>=total;
    bar.style.width=(done?100:(n/total)*100)+'%';
    lbl.textContent=done?'Your match':'Question 0'+(n+1)+' / 0'+total;
    back.hidden=n===0||done;hint.hidden=done;
  }
  function score(){
    const t={fresh:0,floral:0,woody:0,oriental:0,musk:0};
    picks.forEach(w=>w.split(',').forEach(pair=>{const[k,v]=pair.split(':');t[k]+=+v}));
    return Object.keys(t).sort((a,b)=>t[b]-t[a])[0];
  }
  function finish(){
    const fam=score(),name=map[fam];
    const card=[...document.querySelectorAll('.card')].find(c=>c.dataset.name===name);
    document.querySelectorAll('.card.match').forEach(c=>c.classList.remove('match'));
    if(card){
      card.classList.add('match');
      document.getElementById('rImg').src=card.dataset.img;
      document.getElementById('rImg').alt=name;
      document.getElementById('rName').textContent=name;
      document.getElementById('rDesc').textContent=card.dataset.desc;
      document.getElementById('rNotes').innerHTML='Notes &nbsp;/&nbsp; '+[card.dataset.top,card.dataset.heart,card.dataset.base].join('|').split('|').join(', ');
      document.getElementById('rView').onclick=()=>{
        card.scrollIntoView({behavior:'smooth',block:'center'});
        setTimeout(()=>openModal(card),600);
      };
    }
    document.getElementById('rFamily').textContent=famLabel[fam];
    show(total);
  }
  quiz.querySelectorAll('.opt').forEach(btn=>{
    btn.addEventListener('click',()=>{
      const step=btn.closest('.step');
      step.querySelectorAll('.opt').forEach(o=>o.classList.remove('sel'));
      btn.classList.add('sel');
      picks[+step.dataset.step]=btn.dataset.w;
      setTimeout(()=>{i+1>=total?finish():show(i+1)},220);
    });
  });
  back.addEventListener('click',()=>show(Math.max(0,i-1)));
  document.getElementById('rAgain').addEventListener('click',()=>{
    picks=[];quiz.querySelectorAll('.opt.sel').forEach(o=>o.classList.remove('sel'));
    document.querySelectorAll('.card.match').forEach(c=>c.classList.remove('match'));
    show(0);quiz.scrollIntoView({behavior:'smooth',block:'center'});
  });
  show(0);
  if(location.hash==='#scent-finder')setTimeout(()=>quiz.scrollIntoView({behavior:'smooth',block:'center'}),300);
})();
</script>
</BaseLayout>
