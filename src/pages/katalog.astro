  data-name="CAVA NO.05" data-desc="Kayu kering dan asap tipis untuk kehadiran yang tenang." data-top="Black Pepper|Elemi" data-heart="Cypress|Leather" data-base="Oud|Cedarwood" data-img="/media/cava-jungle.jpg">
  <div class="ph"><img decoding="async" src="/media/cava-jungle.jpg" alt="CAVA NO.05 eau de parfum" loading="lazy"></div>
  <div class="card-body">
    <h3>CAVA NO.05</h3>
    <p class="meta">Eau de Parfum &nbsp;/&nbsp; 50 ML</p>
    <p class="lede" style="margin-top:1rem">Kayu kering dan asap tipis untuk kehadiran yang tenang.</p>
    <span class="btn btn-ghost" style="margin-top:1.6rem">View details <span class="arw">&rarr;</span></span>
  </div>
</article>
<article class="card reveal" data-delay="450" data-cursor="VIEW" tabindex="0" role="button"
  data-name="CAVA NO.06" data-desc="Musk bersih dengan sentuhan almond dan kulit yang lembut." data-top="Aldehydes|Bergamot" data-heart="Almond|Orris" data-base="White Musk|Amberwood" data-img="/images/cava-editorial-03.jpg">
  <div class="ph"><img decoding="async" src="/images/cava-editorial-03.jpg" alt="CAVA NO.06 eau de parfum" loading="lazy"></div>
  <div class="card-body">
    <h3>CAVA NO.06</h3>
    <p class="meta">Eau de Parfum &nbsp;/&nbsp; 50 ML</p>
    <p class="lede" style="margin-top:1rem">Musk bersih dengan sentuhan almond dan kulit yang lembut.</p>
    <span class="btn btn-ghost" style="margin-top:1.6rem">View details <span class="arw">&rarr;</span></span>
  </div>
</article>
  </div>
</section>

<div class="modal" id="modal" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Detail produk">
  <button class="modal-close" id="modalClose" aria-label="Tutup detail">CLOSE &times;</button>
  <div class="modal-inner">
    <img decoding="async" loading="lazy" id="mImg" src="/images/cava-bottle-01.jpg" alt="">
    <div class="modal-content">
      <p class="eyebrow" id="mEyebrow">Eau de Parfum</p>
      <h2 class="disp-sm" id="mName" style="margin:1rem 0 1.25rem">CAVA NO.01</h2>
      <p class="lede" id="mDesc"></p>
      <hr class="rule" style="margin:2.5rem 0">
      <div class="grid" style="grid-template-columns:1fr 1fr;gap:2rem">
        <div><p class="eyebrow">Top notes</p><p id="mTop" style="font-family:var(--serif);font-size:1.4rem;line-height:1.5"></p></div>
        <div><p class="eyebrow">Heart notes</p><p id="mHeart" style="font-family:var(--serif);font-size:1.4rem;line-height:1.5"></p></div>
        <div><p class="eyebrow">Base notes</p><p id="mBase" style="font-family:var(--serif);font-size:1.4rem;line-height:1.5"></p></div>
