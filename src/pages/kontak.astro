---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Kontak — CAVA PERFUME";
const description = "Kontak CAVA PERFUME melalui email atau sosial media. cavaparfume.bandung@gmail.com";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "CAVA PERFUME",
  "description": "Kontak CAVA PERFUME melalui email atau sosial media. cavaparfume.bandung@gmail.com",
  "isPartOf": {
    "@type": "WebSite",
    "name": "CAVA PERFUME",
    "url": "https://id-preview--0b81df86-aa7b-4188-920d-4464189dc207.lovable.app"
  }
};
---

<BaseLayout
  title={title}
  description={description}
  ogImage="/images/cava-editorial-02.jpg"
  ogType="website"
  preload="/images/cava-editorial-02.jpg"
  jsonLd={jsonLd}
>
<div class="cursor" aria-hidden="true">VIEW</div>

<header class="nav" id="nav">
  <a class="logo" href="/" aria-label="CAVA Perfume beranda">CAVA<small>Parfums | Luxury Fragrances</small></a>
  <nav aria-label="Navigasi utama">
    <ul class="nav-links">
      <li><a href="/">Beranda</a></li>
      <li class="nav-shop"><a href="/online-shop">Online Shop</a></li>
      <li><a href="/varian-aroma">Varian Aroma</a></li>
      <li><a href="/katalog">Katalog</a></li>
      <li><a href="/kontak" aria-current="page">Kontak</a></li>
    </ul>
  </nav>
  <button class="burger" id="burger" aria-label="Buka menu" aria-expanded="false"><span></span><span></span><span></span></button>
</header>
<div class="mobile-menu" id="mobileMenu" role="dialog" aria-label="Menu">
  <ol>
    <li><a href="/">Beranda</a></li>
    <li><a href="/online-shop">Online Shop</a></li>
    <li><a href="/varian-aroma">Varian Aroma</a></li>
    <li><a href="/katalog">Katalog</a></li>
    <li><a href="/kontak">Kontak</a></li>
  </ol>
  <div class="menu-foot">cavaparfume.bandung@gmail.com</div>
</div>

<main id="main" tabindex="-1"><section class="page-hero">
  <img decoding="async" loading="eager" class="bg" src="/images/cava-editorial-02.jpg" alt="" data-par="-40" fetchpriority="high">
  <div class="inner">
    <p class="eyebrow">Kontak</p>
    <h1 class="disp mask in" style="margin-top:1.5rem"><span>Hubungi</span></h1>
    <h1 class="disp mask in"><span>CAVA.</span></h1>
    <p class="lede" style="margin-top:2rem;color:rgba(255,255,255,.75)">Temukan CAVA di Bandung dan ikuti momen wangi kami lewat media sosial atau email langsung.</p>
  </div>
</section>

<section class="section wrap">
  <div class="contact-grid">
    <div class="reveal contact-panel">
      <p class="eyebrow">Email</p>
      <h2 class="disp-sm" style="margin-top:1rem">CAVA<br>Perfume</h2>
      <p class="lede" style="margin-top:2rem"><a href="mailto:cavaparfume.bandung@gmail.com">cavaparfume.bandung@gmail.com</a></p>
      <hr class="rule" style="margin:2.5rem 0">
      <div class="social-stack" aria-label="Sosial media CAVA">
        <a class="btn btn-ghost" href="https://www.instagram.com/cavaparfume" target="_blank" rel="noopener noreferrer">Instagram <span class="arw">&rarr;</span></a>
        <a class="btn btn-ghost" href="https://www.tiktok.com/@cavaparfume?is_from_webapp=1&sender_device=pc" target="_blank" rel="noopener noreferrer">TikTok <span class="arw">&rarr;</span></a>
        <a class="btn btn-ghost" href="https://wa.me/6285147465734" target="_blank" rel="noopener noreferrer">WhatsApp <span class="arw">&rarr;</span></a>
      </div>
    </div>

    <div class="reveal map-panel" aria-label="Lokasi CAVA di Bandung">
      <div class="map-card">
        <iframe
          src="https://www.google.com/maps?q=Bandung%20Indonesia&z=12&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
          title="Peta lokasi CAVA di Bandung">
        </iframe>
      </div>
      <p class="map-label">Bandung, Indonesia</p>
    </div>
  </div>
</section>

</main>
<footer class="footer">
  <div class="footer-grid">
    <div>
      <a class="logo" href="/" aria-label="CAVA Perfume beranda">CAVA<small>Parfums | Luxury Fragrances</small></a>
      <p class="lede" style="margin-top:1.5rem">Modern fragrance.<br>Timeless presence.</p>
    </div>
    <div><h4>Navigasi</h4><ul><li><a href="/">Beranda</a></li><li><a href="/varian-aroma">Varian Aroma</a></li><li><a href="/katalog">Katalog</a></li><li><a href="/kontak">Kontak</a></li></ul></div>
    <div><h4>Social</h4><ul><li><a href="https://www.instagram.com/cavaparfume" target="_blank" rel="noopener noreferrer" aria-label="CAVA PERFUME di Instagram">Instagram</a></li><li><a href="https://www.tiktok.com/@cavaparfume?is_from_webapp=1&sender_device=pc" target="_blank" rel="noopener noreferrer" aria-label="CAVA PERFUME di TikTok">TikTok</a></li><li><a href="https://wa.me/6285147465734" target="_blank" rel="noopener noreferrer" aria-label="Hubungi CAVA PERFUME via WhatsApp">WhatsApp</a></li></ul></div>
    <div><h4>Kontak</h4><ul><li><a href="mailto:cavaparfume.bandung@gmail.com">cavaparfume.bandung@gmail.com</a></li></ul></div>
  </div>
  <div class="footer-bottom"><span>&copy; 2026 CAVA PERFUME. All rights reserved.</span><span>Scent of character</span></div>
</footer>

<style>
.contact-grid{display:grid;grid-template-columns:1fr 1.2fr;gap:clamp(2rem,5vw,5rem);align-items:center}
.contact-panel,.map-panel{display:flex;flex-direction:column}
.social-stack{display:flex;flex-direction:column;align-items:flex-start;gap:1rem;margin-top:1rem}
.map-card{position:relative;overflow:hidden;border:1px solid var(--light-gray);background:var(--white);min-height:480px;box-shadow:0 20px 60px rgba(5,5,5,.08)}
.map-card iframe{display:block;width:100%;height:100%;min-height:480px;border:0}
.map-label{margin-top:1rem;font-size:11px;letter-spacing:.28em;text-transform:uppercase;color:var(--gray)}

@media (max-width: 820px){
  .contact-grid{grid-template-columns:1fr}
  .map-card,.map-card iframe{min-height:360px}
}
</style>

<script is:inline>
/* respects prefers-reduced-motion: skips parallax + heavy effects */

const nav=document.getElementById('nav');
addEventListener('scroll',()=>{nav.classList.toggle('scrolled',scrollY>40)},{passive:true});
const burger=document.getElementById('burger');
burger.addEventListener('click',()=>{
  const open=document.body.classList.toggle('menu-open');
  burger.setAttribute('aria-expanded',open);
  burger.setAttribute('aria-label',open?'Tutup menu':'Buka menu');
});
document.querySelectorAll('#mobileMenu a').forEach(a=>a.addEventListener('click',()=>document.body.classList.remove('menu-open')));
addEventListener('keydown',e=>{if(e.key==='Escape')document.body.classList.remove('menu-open')});

const io=new IntersectionObserver((es)=>{es.forEach(e=>{if(e.isIntersecting){
  const el=e.target;const d=el.dataset.delay||0;setTimeout(()=>el.classList.add('in'),d);io.unobserve(el);}})},{threshold:.16});
document.querySelectorAll('.reveal,.mask,.img-reveal').forEach(el=>io.observe(el));

// parallax
const reduce=matchMedia('(prefers-reduced-motion:reduce)').matches;
const px=reduce?[]:[...document.querySelectorAll('[data-par]')];
let ticking=false;
function par(){px.forEach(el=>{const r=el.getBoundingClientRect();
  const p=(r.top+r.height/2-innerHeight/2)/innerHeight;
  el.style.transform='translate3d(0,'+(p*parseFloat(el.dataset.par)).toFixed(2)+'px,0)';});ticking=false;}
addEventListener('scroll',()=>{if(!ticking){ticking=true;requestAnimationFrame(par)}},{passive:true});par();

// smooth scroll (lightweight lerp)
if(matchMedia('(min-width:821px)').matches && !matchMedia('(prefers-reduced-motion:reduce)').matches){
  let target=scrollY,cur=scrollY,run=false;
  addEventListener('wheel',e=>{
    if(document.body.classList.contains('menu-open')||document.querySelector('.modal.open'))return;
    e.preventDefault();
    target=Math.max(0,Math.min(document.body.scrollHeight-innerHeight,target+e.deltaY));
    if(!run){run=true;requestAnimationFrame(loop)}
  },{passive:false});
  function loop(){cur+=(target-cur)*.09;if(Math.abs(target-cur)<.5){cur=target;run=false}
    scrollTo(0,cur);if(run)requestAnimationFrame(loop)}
  addEventListener('scrollend',()=>{if(!run){target=cur=scrollY}});
}

// custom cursor
const cur=document.querySelector('.cursor');
if(cur&&matchMedia('(hover:hover)').matches){
  addEventListener('mousemove',e=>{cur.style.left=e.clientX+'px';cur.style.top=e.clientY+'px'});
  document.querySelectorAll('[data-cursor]').forEach(el=>{
    el.addEventListener('mouseenter',()=>{cur.textContent=el.dataset.cursor;cur.classList.add('show')});
    el.addEventListener('mouseleave',()=>cur.classList.remove('show'));
  });
}

</script>
</BaseLayout>
