---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Toko Online — CAVA PERFUME";
const description = "Beli CAVA PERFUME di Shopee, TikTok Shop, atau hubungi langsung via WhatsApp. Pengiriman ke seluruh Indonesia.";
---

<BaseLayout
  title={title}
  description={description}
  ogImage="/media/cava-duo.jpg"
  ogType="website"
  preload="/media/cava-duo.jpg"
>
<div class="cursor" aria-hidden="true">VIEW</div>

<header class="nav light" id="nav">
  <a class="logo" href="/" aria-label="CAVA Perfume beranda">CAVA<small>Parfums | Luxury Fragrances</small></a>
  <nav aria-label="Navigasi utama">
    <ul class="nav-links">
      <li><a href="/">Beranda</a></li>
      <li class="nav-shop"><a href="/online-shop" aria-current="page">Online Shop</a></li>
      <li><a href="/varian-aroma">Varian Aroma</a></li>
      <li><a href="/katalog">Katalog</a></li>
      <li><a href="/kontak">Kontak</a></li>
    </ul>
  </nav>
  <button class="burger" id="burger" aria-label="Buka menu" aria-expanded="false"><span></span><span></span><span></span></button>
</header>
<div class="mobile-menu" id="mobileMenu" role="dialog" aria-label="Menu">
  <ol>
    <li><a href="/">Beranda</a></li>
    <li><a href="/online-shop">Online Shop</a></li>
    <li><a href="/varian-aroma">Varian Aroma</a></li>
    <li><a href="/katalog">Katalog</a></li>
    <li><a href="/kontak">Kontak</a></li>
  </ol>
  <div class="menu-foot">hello@cavaperfume.com</div>
</div>

<main id="main" tabindex="-1">

<!-- PAGE HEADER -->
<section style="padding:10rem var(--pad) clamp(3rem,6vw,5rem);background:var(--off-white)">
  <p class="eyebrow reveal">Beli CAVA Perfume</p>
  <h1 class="disp mask in" style="margin-top:1.5rem"><span>Toko</span></h1>
  <h1 class="disp mask in"><span>Online</span></h1>
  <p class="lede reveal" style="margin-top:2rem">Temukan CAVA PERFUME di platform favorit kamu.<br>Pengiriman ke seluruh Indonesia.</p>
</section>

<!-- SHOP CARDS -->
<section class="section wrap" aria-labelledby="shop-title">
  <h2 id="shop-title" class="reveal" style="font-family:var(--sans);font-size:11px;letter-spacing:.42em;text-transform:uppercase;color:var(--gray);margin-bottom:4rem">Tersedia di</h2>
  <div class="shop-grid">

    <!-- Shopee -->
    <a class="shop-card reveal" href="https://id.shp.ee/9wC21tmX" target="_blank" rel="noopener noreferrer" aria-label="Beli di Shopee">
      <!-- Shopee orange logo -->
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="32" cy="32" r="32" fill="#EE4D2D"/>
        <path d="M32 10c-5.8 0-10.5 4.3-10.5 9.6 0 .7.1 1.3.2 2H16l-2 26h36l-2-26h-5.7c.1-.7.2-1.3.2-2C42.5 14.3 37.8 10 32 10zm0 4c3.6 0 6.5 2.5 6.5 5.6 0 .7-.2 1.4-.4 2h-12.2c-.2-.6-.4-1.3-.4-2C25.5 16.5 28.4 14 32 14zm-10 14h20l1.5 18h-23L22 28z" fill="white"/>
      </svg>
      <p class="shop-card-name">Shopee</p>
      <p class="shop-card-sub">CAVA Official Store</p>
      <span class="shop-card-cta">Kunjungi Toko <span class="arw">&rarr;</span></span>
    </a>

    <!-- TikTok Shop -->
    <a class="shop-card reveal" data-delay="100" href="https://vt.tiktok.com/ZSVDL1NkM/?page=Mall" target="_blank" rel="noopener noreferrer" aria-label="Beli di TikTok Shop">
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="32" cy="32" r="32" fill="#010101"/>
        <path d="M42 14h-6v22.5a5.5 5.5 0 11-5.5-5.5c.5 0 1 .1 1.5.2V25a11.5 11.5 0 100 23 11.5 11.5 0 0011.5-11.5V24.2A16 16 0 0048 26v-6a10 10 0 01-6-6z" fill="white"/>
      </svg>
      <p class="shop-card-name">TikTok Shop</p>
      <p class="shop-card-sub">CAVA Official Mall</p>
      <span class="shop-card-cta">Kunjungi Toko <span class="arw">&rarr;</span></span>
    </a>

    <!-- WhatsApp -->
    <a class="shop-card reveal" data-delay="200" href="https://wa.me/6285147465734" target="_blank" rel="noopener noreferrer" aria-label="Hubungi via WhatsApp">
      <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="32" cy="32" r="32" fill="#25D366"/>
        <path d="M32 10C19.85 10 10 19.85 10 32c0 3.9 1.05 7.6 2.9 10.8L10 54l11.5-2.85A21.85 21.85 0 0032 54c12.15 0 22-9.85 22-22S44.15 10 32 10zm10.9 30.6c-.45 1.25-2.6 2.4-3.6 2.55-.95.15-2.15.2-3.45-.2--.8-.25-1.82-.6-3.15-1.2-5.55-2.4-9.15-8-9.45-8.4-.3-.35-2.4-3.2-2.4-6.1s1.55-4.35 2.1-4.95c.55-.6 1.2-.75 1.6-.75.4 0 .8 0 1.15.02.37.02.87-.14 1.36 1.04.5 1.2 1.7 4.1 1.85 4.4.15.3.25.65.05 1.05-.2.4-.3.65-.6.95-.3.3-.63.67-.9.9-.3.25-.6.52-.26 1.02.35.5 1.55 2.55 3.33 4.13 2.28 2.03 4.2 2.66 4.7 2.95.5.3.8.25 1.1-.15.3-.4 1.3-1.5 1.65-2.02.35-.5.7-.42 1.17-.25.48.17 3.05 1.44 3.57 1.7.5.26.84.4.97.6.12.22.12 1.27-.33 2.52z" fill="white"/>
      </svg>
      <p class="shop-card-name">WhatsApp</p>
      <p class="shop-card-sub">+62 851-4746-5734</p>
      <span class="shop-card-cta">Chat Sekarang <span class="arw">&rarr;</span></span>
    </a>

  </div>
</section>

<!-- INFO SECTION -->
<section class="section dark wrap" style="text-align:center">
  <h2 class="disp-sm reveal">Butuh bantuan<br>memilih aroma?</h2>
  <p class="lede reveal" style="margin:2rem auto 3rem">Tim kami siap membantu kamu menemukan parfum yang sesuai dengan kepribadian dan kebutuhan.</p>
  <a class="btn btn-light" href="https://wa.me/6285147465734?text=Halo%20CAVA%20PERFUME%2C%20saya%20ingin%20konsultasi%20pilihan%20parfum." target="_blank" rel="noopener">Konsultasi Gratis via WA <span class="arw">&rarr;</span></a>
</section>

</main>
<footer class="footer">
  <div class="footer-grid">
    <div>
      <a class="logo" href="/" aria-label="CAVA Perfume beranda">CAVA<small>Parfums | Luxury Fragrances</small></a>
      <p class="lede" style="margin-top:1.5rem">Aroma modern.<br>Kehadiran abadi.</p>
    </div>
    <div><h4>Navigasi</h4><ul><li><a href="/">Beranda</a></li><li><a href="/varian-aroma">Varian Aroma</a></li><li><a href="/katalog">Katalog</a></li><li><a href="/kontak">Kontak</a></li></ul></div>
    <div><h4>Beli</h4><ul><li><a href="/online-shop">Online Shop</a></li><li><a href="https://id.shp.ee/9wC21tmX" target="_blank" rel="noopener">Shopee</a></li><li><a href="https://vt.tiktok.com/ZSVDL1NkM/?page=Mall" target="_blank" rel="noopener">TikTok Shop</a></li><li><a href="https://wa.me/6285147465734" target="_blank" rel="noopener">WhatsApp</a></li></ul></div>
    <div><h4>Kontak</h4><ul><li><a href="mailto:hello@cavaperfume.com">hello@cavaperfume.com</a></li></ul></div>
  </div>
  <div class="footer-bottom"><span>&copy; 2026 CAVA PERFUME. Semua hak dilindungi.</span><span>Scent of Character</span></div>
</footer>

<script is:inline>
const nav=document.getElementById('nav');
addEventListener('scroll',()=>{
  const s=scrollY>40;
  nav.classList.toggle('scrolled',s);
},{passive:true});
const burger=document.getElementById('burger');
burger.addEventListener('click',()=>{
  const open=document.body.classList.toggle('menu-open');
  burger.setAttribute('aria-expanded',open);
  burger.setAttribute('aria-label',open?'Tutup menu':'Buka menu');
});
document.querySelectorAll('#mobileMenu a').forEach(a=>a.addEventListener('click',()=>document.body.classList.remove('menu-open')));
addEventListener('keydown',e=>{if(e.key==='Escape')document.body.classList.remove('menu-open')});

const io=new IntersectionObserver((es)=>{es.forEach(e=>{if(e.isIntersecting){
  const el=e.target;const d=el.dataset.delay||0;setTimeout(()=>el.classList.add('in'),d);io.unobserve(el);}})},{threshold:.16});
document.querySelectorAll('.reveal,.mask,.img-reveal').forEach(el=>io.observe(el));

const curEl=document.querySelector('.cursor');
if(curEl&&matchMedia('(hover:hover)').matches){
  addEventListener('mousemove',e=>{curEl.style.left=e.clientX+'px';curEl.style.top=e.clientY+'px'});
}
</script>

<style>
/* Online Shop page-specific: light nav on scroll */
#nav{color:var(--black)}
#nav.scrolled{background:rgba(245,245,242,.85)}
</style>
</BaseLayout>
